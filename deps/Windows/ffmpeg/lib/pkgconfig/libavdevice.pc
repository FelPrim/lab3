prefix=/t/GitHub/my_scripts/lab3/deps/Windows/ffmpeg
exec_prefix=${prefix}
libdir=/t/GitHub/my_scripts/lab3/deps/Windows/ffmpeg/lib
includedir=/t/GitHub/my_scripts/lab3/deps/Windows/ffmpeg/include

Name: libavdevice
Description: FFmpeg device handling library
Version: 62.2.100
Requires: 
Requires.private: libavfilter >= 11.9.100, libswscale >= 9.3.100, libavformat >= 62.6.100, libavcodec >= 62.16.100, libswresample >= 6.2.100, libavutil >= 60.13.100
Conflicts:
Libs: -L${libdir}  -lavdevice 
Libs.private: -lpsapi -lole32 -lstrmiids -luuid -loleaut32 -lshlwapi -lgdi32 -lm -latomic -lvfw32
Cflags: -I${includedir}
